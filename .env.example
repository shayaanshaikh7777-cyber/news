# Environment Configuration for Awaaz Jamkhedcha
# Database Connection (PostgreSQL for production & development)
DATABASE_URL="postgresql://postgres:password@localhost:5432/awaaz_jamkhedcha?schema=public"

# Authentication & Session Security
JWT_SECRET="replace-with-a-secure-secret-key"
NEXTAUTH_SECRET="replace-with-a-secure-secret-key"

# AI News Studio (Google Gemini API)
# Current recommended production model: gemini-3.8-flash
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Awaaz Jamkhedcha"
NEXT_PUBLIC_SITE_NAME_MARATHI="आवाज जामखेडचा"
NEXT_PUBLIC_SITE_TAGLINE="जामखेड आणि पंचक्रोशीचा बुलंद आवाज"

# Monetization (Google AdSense)
NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-9876543210987654"

# Web Push Notification Keys (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="public_vapid_key"
VAPID_PRIVATE_KEY="secret_vapid_key"

# WhatsApp Business Cloud API Integration (Optional)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN="awaaz_jamkhedcha_verify"

# Object Storage (S3 / Cloudflare R2) - Falls back to local public storage if empty
S3_ENDPOINT=""
S3_BUCKET="awaaz-jamkhedcha-media"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="ap-south-1"

